{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TelemetryHub": "Debug"
    }
  },
  "AllowedHosts": "*",
  "TelemetryChannel": {
    "Capacity": 10000,
    "FullMode": "Wait",
    "SingleReader": true,
    "AllowSynchronousContinuations": false
  }
}
